# Copy this file to .env and fill in your own values.
# The server reads these via `node --env-file=.env` (see package.json).

# Base URL of your AI provider, e.g. https://api.openai.com/v1
AI_URL=
# Model name, e.g. gpt-4o-mini
AI_MODEL=
# Your API key
AI_KEY=

# Optional. Port for the Express API. Defaults to 3001.
# API_PORT=3001
